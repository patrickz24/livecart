{
  "name": "livecart",
  "version": "0.0.0",
  "private": true,
  "description": "Live-shopping MVP: purchase intents captured from live comments, atomic stock reservation and checkout.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.6.0 <13"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen-api": "uv run --locked python services/api/scripts/export_openapi.py && pnpm --filter @livecart/api-client run generate",
    "check:openapi": "pnpm run gen-api && node scripts/check-openapi-drift.mjs",
    "check:node": "node scripts/check-node.mjs",
    "check:pins": "node scripts/check-pins.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "smoke:compose": "node scripts/smoke-compose.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "lefthook": "2.1.14",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}

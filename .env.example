# LiveCart configuration template. Copy it once, then adjust .env:
#   cp .env.example .env
# .env is never committed. Host-run commands (uv run ...) read it from the
# repository root; real environment variables take precedence over it.
# Values containing "change-me" are development placeholders: the API, the
# worker and livecart-migrate refuse to start with one when APP_ENV=production.
# Host-run URLs use 127.0.0.1, not localhost: on Windows localhost resolves to
# ::1 first, and each connection to a port published on 127.0.0.1 only would
# then wait about 2 s before falling back.

# --- Runtime ---
# development | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR (logs are JSON lines on stdout)
LOG_LEVEL=INFO

# --- Connections used by the API and the worker ---
# PostgreSQL as livecart_app, the least-privileged role (SELECT, INSERT and
# UPDATE only). The asyncpg driver is required.
DATABASE_URL=postgresql+asyncpg://livecart_app:change-me-app@127.0.0.1:55432/livecart
# Redis with its requirepass password (redis:// or rediss:// for TLS).
REDIS_URL=redis://:change-me-redis@127.0.0.1:56379/0
# First segment of every Redis key the API and the worker write, such as the
# idempotency keys {prefix}:idem:restock:<seller>:<key>, so that deployments
# sharing one Redis stay apart: words of letters, digits, "_" and "-" joined by
# ":", 64 characters at most.
# REDIS_KEY_PREFIX=livecart

# --- Signing keys (API and worker) ---
# At least 32 bytes each, and different from each other: the process refuses
# to start otherwise. JWT_SECRET signs the sellers' access tokens (HS256).
# ORDER_TOKEN_KEY derives the access token of every order by HMAC, so whoever
# holds it can compute them all. Real values, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-jwt-change-me-jwt-change-me-jwt
ORDER_TOKEN_KEY=change-me-order-change-me-order-change-me

# --- Worker ---
# File touched every 10 s while Redis answers PING, and read by the container
# healthcheck (livecart-healthcheck heartbeat). Default: livecart-worker.heartbeat
# in the system temp directory (/tmp in containers).
# WORKER_HEARTBEAT_FILE=/tmp/livecart-worker.heartbeat

# --- Business rules (API and worker) ---
# Largest quantity one comment may order; above it the intent is rejected as
# quantity_out_of_bounds. From 1 to 99, the bound of the database CHECK on
# purchase intents: the process refuses to start outside it.
# MAX_QUANTITY_PER_COMMENT=10
# Seconds an unpaid reservation holds the stock before the sweep releases it,
# from 60 to 86400 (validated at startup).
# RESERVATION_TTL_SECONDS=900
# The one currency of the deployment (ISO 4217), frozen on every order.
# DEFAULT_CURRENCY=EUR

# --- HTTP (API) ---
# The Host headers the API answers, between commas; any other gets 400.
# Keep 127.0.0.1 (the container healthcheck) and api (the other containers).
# For a phone on the LAN (Expo Go), add the PC's LAN address, for example
# localhost,127.0.0.1,api,192.168.1.20. Never *.
# ALLOWED_HOSTS=localhost,127.0.0.1,api
# Strict-Transport-Security on every answer: only once the API is served
# over HTTPS, since browsers then refuse plain HTTP to it for a year.
# HSTS_ENABLED=false

# --- Rate limits (API): fixed windows in Redis, 429 with Retry-After ---
# The plan's defaults, to recalibrate once measured; each from 1 to 1000000.
# Logins per minute per client address, and failed logins per (account,
# address) per window (60 to 86400 s). Logins answer 503 while Redis is down;
# every other limit then lets requests through.
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_LOGIN_FAILURES=5
# RATE_LIMIT_LOGIN_FAILURE_WINDOW_SECONDS=900
# Requests per minute per seller, on every seller route.
# RATE_LIMIT_SELLER_PER_MINUTE=300
# Order lookups by reference per minute per client address, and how many of
# them may answer 404, the 404s of the token routes included. Above
# BUYER_LOOKUP_NOT_FOUND_ALERT_PER_MINUTE 404s a minute from all addresses
# together, a warning is logged.
# RATE_LIMIT_BUYER_LOOKUP_PER_MINUTE=30
# RATE_LIMIT_BUYER_LOOKUP_NOT_FOUND_PER_MINUTE=20
# BUYER_LOOKUP_NOT_FOUND_ALERT_PER_MINUTE=100
# Requests per minute per order access token, on the buyer's token routes.
# RATE_LIMIT_BUYER_TOKEN_PER_MINUTE=60

# --- Migrations (livecart-migrate) ---
# PostgreSQL as livecart_migrator, owner of the schema. Only the migrate
# command reads it; the API and the worker never receive it.
MIGRATOR_URL=postgresql+asyncpg://livecart_migrator:change-me-migrator@127.0.0.1:55432/livecart

# --- Demo seed (livecart-seed, the compose seed service) ---
# Password of the demo sellers demo-seller@livecart.test and
# sample-shop@livecart.test, 12 to 128 characters, set when the seed first
# creates them (a later change needs `make reset`). Only the seed reads it; it
# connects through MIGRATOR_URL.
SEED_DEMO_PASSWORD=change-me-demo-seller

# --- PostgreSQL and Redis passwords (compose.yaml, infra/postgres/init-roles.sh) ---
# compose.yaml has no default for any of them and refuses to start without
# them. The role passwords are set once, when the postgres data volume is first
# initialised (`make reset` deletes it). compose builds the containers'
# connection URLs from these values, so keep to letters, digits, "-", "_" and
# ".", and make them match the passwords inside DATABASE_URL, MIGRATOR_URL,
# REDIS_URL and the TEST_* URLs of this file.
# Superuser of the postgres container, used only by its entrypoint.
POSTGRES_PASSWORD=change-me-postgres
LIVECART_MIGRATOR_PASSWORD=change-me-migrator
LIVECART_APP_PASSWORD=change-me-app
# Redis requirepass.
REDIS_PASSWORD=change-me-redis

# --- Docker Compose network and host ports ---
# PostgreSQL and Redis are published on 127.0.0.1 only, on non-standard ports
# so that another project's servers can keep 5432 and 6379. After changing a
# port, change it in the host-run URLs of this file too.
PG_HOST_PORT=55432
REDIS_HOST_PORT=56379
# Fixed address of nginx inside the compose subnet: the only proxy uvicorn
# trusts for X-Forwarded-For (--forwarded-allow-ips; never *). It must belong
# to COMPOSE_SUBNET but stay outside COMPOSE_IP_RANGE, the part of the subnet
# where Docker picks the dynamic addresses of the other containers.
NGINX_IP=172.30.0.10
# COMPOSE_SUBNET=172.30.0.0/24
# COMPOSE_IP_RANGE=172.30.0.128/25
# Any Redis-compatible image (Redis >= 7.0 commands only), for example
# valkey/valkey:9.1.2-alpine.
# REDIS_IMAGE=redis:8.10.2-alpine

# --- Host-run integration tests (uv run pytest -m integration) ---
# Always the livecart_test database: the fixtures refuse any database whose
# name does not end in _test, and any Redis database other than 15. Each test
# also writes its Redis keys under a prefix of its own.
TEST_DATABASE_URL=postgresql+asyncpg://livecart_app:change-me-app@127.0.0.1:55432/livecart_test
TEST_MIGRATOR_URL=postgresql+asyncpg://livecart_migrator:change-me-migrator@127.0.0.1:55432/livecart_test
TEST_REDIS_URL=redis://:change-me-redis@127.0.0.1:56379/15

# LiveCart configuration template. Copy it once, then adjust .env:
#   cp .env.example .env
# .env is never committed. Host-run commands (uv run ...) read it from the
# repository root; real environment variables take precedence over it.
# Values containing "change-me" are development placeholders: the API, the
# worker and livecart-migrate refuse to start with one when APP_ENV=production.
# Host-run URLs use 127.0.0.1, not localhost: on Windows localhost resolves to
# ::1 first, and each connection to a port published on 127.0.0.1 only would
# then wait about 2 s before falling back.

# --- Runtime ---
# development | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR (logs are JSON lines on stdout)
LOG_LEVEL=INFO

# --- Connections used by the API and the worker ---
# PostgreSQL as livecart_app, the least-privileged role (SELECT, INSERT and
# UPDATE only). The asyncpg driver is required.
DATABASE_URL=postgresql+asyncpg://livecart_app:change-me-app@127.0.0.1:55432/livecart
# Redis with its requirepass password (redis:// or rediss:// for TLS).
REDIS_URL=redis://:change-me-redis@127.0.0.1:56379/0
# First segment of every Redis key the API and the worker write, such as the
# idempotency keys {prefix}:idem:restock:<seller>:<key>, so that deployments
# sharing one Redis stay apart: words of letters, digits, "_" and "-" joined by
# ":", 64 characters at most.
# REDIS_KEY_PREFIX=livecart

# --- Signing keys (API and worker) ---
# At least 32 bytes each, and different from each other: the process refuses
# to start otherwise. JWT_SECRET signs the sellers' access tokens (HS256).
# ORDER_TOKEN_KEY derives the access token of every order by HMAC, so whoever
# holds it can compute them all. Real values, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-jwt-change-me-jwt-change-me-jwt
ORDER_TOKEN_KEY=change-me-order-change-me-order-change-me

# --- Comment webhooks (API): POST /api/v1/webhooks/comments/{platform} ---
# The platforms whose webhook the API serves, between commas, among
# simulator, facebook, instagram and tiktok. Only the simulator has a real
# adapter: the others are documented stubs, and the API refuses to start
# while one is listed here.
# ENABLED_PLATFORMS=simulator
# The HMAC key of each platform's webhook, at least 32 bytes, required for
# every enabled platform. The simulator signs each body with
# X-LiveCart-Signature: t=<unix time>,v1=<hex HMAC-SHA256 of "<t>.<body>">,
# and the API refuses a signature more than 300 s away from its clock.
COMMENT_WEBHOOK_SECRET_SIMULATOR=change-me-simulator-change-me-simulator
# COMMENT_WEBHOOK_SECRET_FACEBOOK, COMMENT_WEBHOOK_SECRET_INSTAGRAM and
# COMMENT_WEBHOOK_SECRET_TIKTOK are the keys of the stubs, unused until their
# adapters exist.

# --- Comment queue and backpressure (API) ---
# Once the consumer group's backlog (lag + pending: comments not acknowledged
# yet, delivered or not) reaches QUEUE_MAX_DEPTH, the webhook answers 503 with
# Retry-After until the workers catch up. From 1 to 1000000.
# QUEUE_MAX_DEPTH=20000
# The largest envelope the webhook queues, in bytes of JSON (a comment of 1000
# emoji takes about 4.7 KB): a larger one is refused with 422. From 5120 to 65536.
# QUEUE_MAX_ENVELOPE_BYTES=5120
# Redis's maxmemory, which compose also gives the redis server. The API
# refuses to start unless QUEUE_MAX_DEPTH x QUEUE_MAX_ENVELOPE_BYTES x 1.25
# (the allocator's rounding, measured) fits in half of it: 20000 x 5120 x 1.25
# is 47.7 % of 256 MiB.
# REDIS_MAXMEMORY_BYTES=268435456

# --- Worker ---
# File touched every 10 s while Redis answers PING and the comment consumer
# goes round, and read by the container healthcheck (livecart-healthcheck
# heartbeat). Default: livecart-worker.heartbeat in the system temp directory
# (/tmp in containers).
# WORKER_HEARTBEAT_FILE=/tmp/livecart-worker.heartbeat
# Comment handlers running at once, each on a database connection of its own
# (1 to 64), and the deliveries a worker holds at most, read and not finished
# (the COUNT of XREADGROUP, 1 to 256).
# WORKER_CONCURRENCY=16
# WORKER_BATCH=32
# Deadline of one comment, from when its handler starts, and length of its
# processing lease, from 5 to 300 seconds. Past it, the comment is left for
# another delivery.
# MESSAGE_PROCESS_TIMEOUT_S=30
# The most connections the worker's pool opens: WORKER_CONCURRENCY + 4 loops
# + 2 on overflow must fit, or the worker refuses to start. Budget them
# against PostgreSQL's 97: the API takes 15, each worker 22 by default.
# WORKER_DB_MAX_CONNECTIONS=22
# Every 30 s each worker reclaims the comments another one left pending for
# QUEUE_RECLAIM_MIN_IDLE_MS, and moves those delivered QUEUE_MAX_DELIVERIES
# times already (1 to 10) to the dead-letter queue. The idle time is derived
# when unset: 2 x ceil(WORKER_BATCH / WORKER_CONCURRENCY) x
# MESSAGE_PROCESS_TIMEOUT_S, 120000 ms by default, the longest a live worker
# holds a comment, twice. A shorter value is refused; a longer one, up to an
# hour, delays the recovery after a crash.
# QUEUE_MAX_DELIVERIES=3
# QUEUE_RECLAIM_MIN_IDLE_MS=120000
# Each order's buyer receives its reference, its access token and the link
# <scheme>://link/<reference>#t=<token> of the buyer app. The platforms'
# direct messages are out of scope: the worker writes them to the Redis
# stream <REDIS_KEY_PREFIX>:dev:buyer-dm (the last 1000, for an hour), for the
# comment simulator's text mode to show (`docker compose run --rm simulator
# --text`). It holds working tokens, so the worker refuses to start with
# APP_ENV=production.
# BUYER_LINK_SCHEME=livecart

# --- LLM fallback (worker, optional) ---
# The comments the parser leaves ambiguous ("je prends C3" for a T-shirt in
# four colours, "je prends deux B07") go to Claude when a key is set. Without
# one, or with LLM_ENABLED=false, they are rejected as ambiguous_unresolved
# and everything else works the same. With a key set, the always-on simulator
# spends the budget: run `docker compose stop simulator` for long idle runs.
ANTHROPIC_API_KEY=
# LLM_ENABLED=true
# The model, by its API id, and how much it may think before it answers
# (low, medium, high, xhigh or max; empty sends none, for a model that takes
# no effort). Change the model only after scripts/llm_eval.py (ADR 0006).
# LLM_MODEL=claude-opus-5
# LLM_EFFORT=low
# A request the model's safety classifiers decline runs again, in the same
# call, on the model Anthropic recommends for it (server-side fallbacks).
# false for a model that does not take them.
# LLM_REFUSAL_FALLBACK=true
# The longest one attempt of a call may take, 1 to 8 s; the SDK retries once.
# LLM_CALL_TIMEOUT_S=8
# The part of each comment's deadline (MESSAGE_PROCESS_TIMEOUT_S) kept for
# what follows the fallback, 1 to 60 s: the fallback gets what is left.
# DB_BUDGET_S=5
# The cost guard, shared by every worker through Redis: calls per live
# session (1 to 100000) and dollars per UTC day (above 0, at most 1000), each
# checked before a call. The dollars are list prices per million input and
# output tokens (LLM_PRICES, a JSON table by model id that replaces the
# default one, which prices claude-opus-5, claude-opus-4-8, claude-sonnet-5 and
# claude-haiku-4-5): an approximation of the bill.
# LLM_MAX_CALLS_PER_SESSION=200
# LLM_DAILY_BUDGET_USD=1.00
# LLM_PRICES={"claude-opus-5": {"input_per_mtok": 5, "output_per_mtok": 25}}
# Each worker asks about 4 comments at once; another one waits for a slot
# LLM_SLOT_WAIT_S at most (1 to 60), then is rejected as ambiguous_unresolved
# (llm_busy). With a key, the worker refuses to start unless
# MESSAGE_PROCESS_TIMEOUT_S >= LLM_CALL_TIMEOUT_S x 2 + 2 + DB_BUDGET_S +
# LLM_SLOT_WAIT_S: 30 >= 8 x 2 + 2 + 5 + 7 by default.
# LLM_SLOT_WAIT_S=7

# --- Comment simulator (compose service simulator, livecart-simulate) ---
# A live audience on the seeded session: comments arrive as a Poisson process
# of SIMULATOR_RATE a second on average (0.01 to 100), mostly purchases, some
# noise and some ambiguous ones, from SIMULATOR_BUYERS fake buyers (1 to
# 1000), signed with COMMENT_WEBHOOK_SECRET_SIMULATOR above. The codes of
# SIMULATOR_EXCLUDE_CODES, between commas, are never named, to buy them by
# hand meanwhile. `docker compose stop simulator` pauses it; `docker compose
# run --rm simulator --text` prints the buyers' messages. From the host,
# `uv run --locked livecart-simulate --help` lists the options; it posts to
# SIMULATOR_API_URL and reads the text mode's messages through REDIS_URL. It
# refuses to run with APP_ENV=production.
# SIMULATOR_RATE=0.2
# SIMULATOR_BUYERS=12
# SIMULATOR_EXCLUDE_CODES=B07,E15
# SIMULATOR_API_URL=http://127.0.0.1:8000

# --- Business rules (API and worker) ---
# Largest quantity one comment may order; above it the intent is rejected as
# quantity_out_of_bounds. From 1 to 99, the bound of the database CHECK on
# purchase intents: the process refuses to start outside it.
# MAX_QUANTITY_PER_COMMENT=10
# Seconds an unpaid reservation holds the stock before the sweep releases it,
# from 60 to 86400 (validated at startup).
# RESERVATION_TTL_SECONDS=900
# The one currency of the deployment (ISO 4217), frozen on every order.
# DEFAULT_CURRENCY=EUR

# --- HTTP (API) ---
# The Host headers the API answers, between commas; any other gets 400.
# Keep 127.0.0.1 (the container healthcheck) and api (the other containers).
# For a phone on the LAN (Expo Go), add the PC's LAN address, for example
# localhost,127.0.0.1,api,192.168.1.20. Never *.
# ALLOWED_HOSTS=localhost,127.0.0.1,api
# Strict-Transport-Security on every answer: only once the API is served
# over HTTPS, since browsers then refuse plain HTTP to it for a year.
# HSTS_ENABLED=false

# --- Rate limits (API): fixed windows in Redis, 429 with Retry-After ---
# The plan's defaults, to recalibrate once measured; each from 1 to 1000000.
# Logins per minute per client address, and failed logins per (account,
# address) per window (60 to 86400 s). Logins answer 503 while Redis is down;
# every other limit then lets requests through.
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_LOGIN_FAILURES=5
# RATE_LIMIT_LOGIN_FAILURE_WINDOW_SECONDS=900
# Requests per minute per seller, on every seller route.
# RATE_LIMIT_SELLER_PER_MINUTE=300
# Order lookups by reference per minute per client address, and how many of
# them may answer 404, the 404s of the token routes included. Above
# BUYER_LOOKUP_NOT_FOUND_ALERT_PER_MINUTE 404s a minute from all addresses
# together, a warning is logged.
# RATE_LIMIT_BUYER_LOOKUP_PER_MINUTE=30
# RATE_LIMIT_BUYER_LOOKUP_NOT_FOUND_PER_MINUTE=20
# BUYER_LOOKUP_NOT_FOUND_ALERT_PER_MINUTE=100
# Requests per minute per order access token, on the buyer's token routes.
# RATE_LIMIT_BUYER_TOKEN_PER_MINUTE=60
# Storefront requests per minute per client address: every viewer of a live
# opens it, and a whole audience may share one mobile carrier's address.
# RATE_LIMIT_STOREFRONT_PER_MINUTE=120
# Comment webhook calls per minute per platform, counted once the signature
# holds. A full comment queue answers 503 instead (backpressure).
# RATE_LIMIT_COMMENT_WEBHOOK_PER_MINUTE=6000

# --- Real-time events (API): GET /api/v1/live-sessions/{id}/events (SSE) ---
# The streams of session events one API instance serves at once, 1 to 5000.
# Each holds a Redis connection waiting in XREAD, from a pool of this many
# connections the streams alone use: the webhook, the login and /ready keep
# the 100 of the shared pool whatever the streams. Past it, 503 with
# Retry-After. A stream closes 5 s before its access token expires, or after
# an hour, and the dashboard reconnects with Last-Event-ID.
# SSE_MAX_STREAMS=200

# --- Metrics (API and worker) ---
# Each process serves its Prometheus metrics (GET /metrics) on this port of
# its container, for a scraper on the compose network: compose never
# publishes it on the host and nginx never routes it. Empty serves none.
# METRICS_PORT=9100

# --- Migrations (livecart-migrate) ---
# PostgreSQL as livecart_migrator, owner of the schema. Only the migrate
# command reads it; the API and the worker never receive it.
MIGRATOR_URL=postgresql+asyncpg://livecart_migrator:change-me-migrator@127.0.0.1:55432/livecart

# --- Demo seed (livecart-seed, the compose seed service) ---
# Password of the demo sellers demo-seller@livecart.test and
# sample-shop@livecart.test, 12 to 128 characters, set when the seed first
# creates them (a later change needs `make reset`). Only the seed reads it; it
# connects through MIGRATOR_URL.
SEED_DEMO_PASSWORD=change-me-demo-seller

# --- PostgreSQL and Redis passwords (compose.yaml, infra/postgres/init-roles.sh) ---
# compose.yaml has no default for any of them and refuses to start without
# them. The role passwords are set once, when the postgres data volume is first
# initialised (`make reset` deletes it). compose builds the containers'
# connection URLs from these values, so keep to letters, digits, "-", "_" and
# ".", and make them match the passwords inside DATABASE_URL, MIGRATOR_URL,
# REDIS_URL and the TEST_* URLs of this file.
# Superuser of the postgres container, used only by its entrypoint.
POSTGRES_PASSWORD=change-me-postgres
LIVECART_MIGRATOR_PASSWORD=change-me-migrator
LIVECART_APP_PASSWORD=change-me-app
# Redis requirepass.
REDIS_PASSWORD=change-me-redis

# --- Docker Compose network and host ports ---
# PostgreSQL and Redis are published on 127.0.0.1 only, on non-standard ports
# so that another project's servers can keep 5432 and 6379. After changing a
# port, change it in the host-run URLs of this file too.
PG_HOST_PORT=55432
REDIS_HOST_PORT=56379
# Fixed address of nginx inside the compose subnet: the only proxy uvicorn
# trusts for X-Forwarded-For (--forwarded-allow-ips; never *). It must belong
# to COMPOSE_SUBNET but stay outside COMPOSE_IP_RANGE, the part of the subnet
# where Docker picks the dynamic addresses of the other containers.
NGINX_IP=172.30.0.10
# COMPOSE_SUBNET=172.30.0.0/24
# COMPOSE_IP_RANGE=172.30.0.128/25
# Any Redis-compatible image (Redis >= 7.0 commands only), for example
# valkey/valkey:9.1.2-alpine.
# REDIS_IMAGE=redis:8.10.2-alpine

# --- Host-run integration tests (uv run pytest -m integration) ---
# Always the livecart_test database: the fixtures refuse any database whose
# name does not end in _test, and any Redis database other than 15. Each test
# also writes its Redis keys under a prefix of its own.
TEST_DATABASE_URL=postgresql+asyncpg://livecart_app:change-me-app@127.0.0.1:55432/livecart_test
TEST_MIGRATOR_URL=postgresql+asyncpg://livecart_migrator:change-me-migrator@127.0.0.1:55432/livecart_test
TEST_REDIS_URL=redis://:change-me-redis@127.0.0.1:56379/15

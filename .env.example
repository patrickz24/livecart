# LiveCart configuration template. Copy it once, then adjust .env:
#   cp .env.example .env
# .env is never committed. Host-run commands (uv run ...) read it from the
# repository root; real environment variables take precedence over it.
# Values containing "change-me" are development placeholders: the API, the
# worker and livecart-migrate refuse to start with one when APP_ENV=production.
# Host-run URLs use 127.0.0.1, not localhost: on Windows localhost resolves to
# ::1 first, and each connection to a port published on 127.0.0.1 only would
# then wait about 2 s before falling back.

# --- Runtime ---
# development | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR (logs are JSON lines on stdout)
LOG_LEVEL=INFO

# --- Connections used by the API and the worker ---
# PostgreSQL as livecart_app, the least-privileged role (SELECT, INSERT and
# UPDATE only). The asyncpg driver is required.
DATABASE_URL=postgresql+asyncpg://livecart_app:change-me-app@127.0.0.1:55432/livecart
# Redis with its requirepass password (redis:// or rediss:// for TLS).
REDIS_URL=redis://:change-me-redis@127.0.0.1:56379/0

# --- Worker ---
# File touched every 10 s while Redis answers PING, and read by the container
# healthcheck (livecart-healthcheck heartbeat). Default: livecart-worker.heartbeat
# in the system temp directory (/tmp in containers).
# WORKER_HEARTBEAT_FILE=/tmp/livecart-worker.heartbeat

# --- Migrations (livecart-migrate) ---
# PostgreSQL as livecart_migrator, owner of the schema. Only the migrate
# command reads it; the API and the worker never receive it.
MIGRATOR_URL=postgresql+asyncpg://livecart_migrator:change-me-migrator@127.0.0.1:55432/livecart

# --- PostgreSQL role passwords (infra/postgres/init-roles.sh) ---
# Set once, when the postgres data volume is first initialised. They must match
# the passwords inside DATABASE_URL, MIGRATOR_URL and the TEST_* URLs.
LIVECART_MIGRATOR_PASSWORD=change-me-migrator
LIVECART_APP_PASSWORD=change-me-app

# --- Host-run integration tests (uv run pytest -m integration) ---
# Always the livecart_test database: the fixtures refuse any database whose
# name does not end in _test. Redis uses database 15.
TEST_DATABASE_URL=postgresql+asyncpg://livecart_app:change-me-app@127.0.0.1:55432/livecart_test
TEST_MIGRATOR_URL=postgresql+asyncpg://livecart_migrator:change-me-migrator@127.0.0.1:55432/livecart_test
TEST_REDIS_URL=redis://:change-me-redis@127.0.0.1:56379/15

{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Expo's base first (JSX, the react-native export condition, bundler
  // resolution), then the repository's strict options, which win.
  "extends": ["expo/tsconfig.base", "../../tsconfig.base.json"],
  "compilerOptions": {
    // DOM for the fetch types of the generated API client, which React
    // Native provides at run time.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true
  },
  // The last two are written by Expo's CLI: the typed routes of expo-router
  // and the reference to Expo's ambient types (`expo customize tsconfig.json`).
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
